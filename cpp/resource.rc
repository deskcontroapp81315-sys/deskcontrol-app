// DeskControl Pro — Resource File
#include <windows.h>

// ─── أيقونة التطبيق ───
// IDI_APP ICON "assets/icon.ico"

// ─── معلومات الإصدار ───
VS_VERSION_INFO VERSIONINFO
FILEVERSION     5,0,0,0
PRODUCTVERSION  5,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DeskControl"
            VALUE "FileDescription",  "DeskControl Pro - Remote Desktop"
            VALUE "FileVersion",      "5.0.0.0"
            VALUE "InternalName",     "DeskControl"
            VALUE "OriginalFilename", "DeskControl.exe"
            VALUE "ProductName",      "DeskControl Pro"
            VALUE "ProductVersion",   "5.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// ─── البيان (DPI Awareness + Common Controls v6) ───
1 RT_MANIFEST
BEGIN
"<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>\r\n"
"<assembly xmlns=""urn:schemas-microsoft-com:asm.v1"" manifestVersion=""1.0"">\r\n"
"  <assemblyIdentity version=""1.0.0.0"" processorArchitecture=""*""\r\n"
"    name=""DeskControl.Pro"" type=""win32""/>\r\n"
"  <dependency>\r\n"
"    <dependentAssembly>\r\n"
"      <assemblyIdentity type=""win32"" name=""Microsoft.Windows.Common-Controls""\r\n"
"        version=""6.0.0.0"" processorArchitecture=""*""\r\n"
"        publicKeyToken=""6595b64144ccf1df"" language=""*""/>\r\n"
"    </dependentAssembly>\r\n"
"  </dependency>\r\n"
"  <asmv3:application xmlns:asmv3=""urn:schemas-microsoft-com:asm.v3"">\r\n"
"    <asmv3:windowsSettings>\r\n"
"      <dpiAware xmlns=""http://schemas.microsoft.com/SMI/2005/WindowsSettings"">true/PM</dpiAware>\r\n"
"      <dpiAwareness xmlns=""http://schemas.microsoft.com/SMI/2016/WindowsSettings"">PerMonitorV2</dpiAwareness>\r\n"
"    </asmv3:windowsSettings>\r\n"
"  </asmv3:application>\r\n"
"</assembly>\r\n"
END
